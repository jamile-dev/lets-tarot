{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "web/dist",
  "build": {
    "env": {},
    "command": "cd web && npm ci --legacy-peer-deps --no-audit --no-fund && npm run build",
    "outputDirectory": "web/dist",
    "installCommand": "npm install --legacy-peer-deps"
  },
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/study/:path*", "destination": "/index.html" },
    { "source": "/decks/:path*", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

# Lets-Tarot API Environment
# Base URL for the PWA (used for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
# Local Docker: postgres://lets_tarot:lets_tarot_dev@localhost:5432/lets_tarot?sslmode=disable
# Supabase/Render: postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgres://lets_tarot:lets_tarot_dev@localhost:5432/lets_tarot?sslmode=disable

# Port to listen on (default: 8080)
PORT=8080

# JWT secret (use a strong random string, min 32 chars)
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars

# CDN base URL for card images (jsDelivr via GitHub Releases)
CDN_BASE_URL=https://cdn.jsdelivr.net/gh/jamile-dev/lets-tarot@v0.1.0/cards

# Supabase Auth (not used in current self-hosted JWT implementation)
SUPABASE_URL=
SUPABASE_ANON_KEY=
